# Copy to .env and adjust for local development.
# Never commit real secrets.
SPRING_PROFILES_ACTIVE=dev
DB_NAME=demo_db
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/demo_db
DB_USER=demo
DB_PASSWORD=demo123
APP_PORT=8080
JWT_SECRET=dev-only-secret-change-me-please-32-bytes-minimum
JWT_EXPIRATION=PT1H
# Bootstrap admin: created on first start if the user does not exist yet.
APP_SECURITY_USER=admin
APP_SECURITY_PASSWORD=admin123
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=dev
